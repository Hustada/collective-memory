{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Hustada/collective-memory",
  "description": "MCP server for persistent, semantic memory across AI sessions",
  "repository": {
    "url": "https://github.com/Hustada/collective-memory",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "collective-memory",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "OpenAI API key for generating embeddings",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "OPENAI_API_KEY"
        }
      ]
    }
  ]
}